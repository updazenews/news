rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function profileRole() { return signedIn() ? userDoc(request.auth.uid).data.role : null; }
    function tokenRole() { return signedIn() ? request.auth.token.role : null; }
    function effectiveRole() { return tokenRole() != null ? tokenRole() : profileRole(); }
    function isPrivileged() { return effectiveRole() in ['admin', 'super admin']; }
    function disabled() { return signedIn() ? userDoc(request.auth.uid).data.disabled == true : true; }

    match /users/{userId} {
      allow read: if true;
      allow write: if signedIn() && isPrivileged();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow create: if signedIn() && !disabled() && effectiveRole() in ['publisher','admin','super admin','editor'];
      allow update: if signedIn() && !disabled() && (
        effectiveRole() in ['admin','super admin'] ||
        (effectiveRole() in ['publisher','editor'] && resource.data.authorUid == request.auth.uid)
      );
      allow delete: if signedIn() && !disabled() && effectiveRole() in ['admin','super admin'];
    }
  }
}
